# Copy to your shell or hosting provider settings. All are optional locally.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bazhanka
DATABASE_SSL=false          # true for hosted Postgres reached over the public internet (Neon, Supabase, Render external URL)
JWT_SECRET=change-me        # REQUIRED in production
ADMIN_EMAILS=you@example.com  # comma-separated; these accounts can open /admin (validation metrics + feedback)
DONATION_URL=               # optional link shown in the footer, e.g. a Monobank jar
DONATION_LABEL=Support a volunteer cause
PORT=3000

# --- Gift ideas (AI search) ---
DISCOVER_MOCK=              # true = offline sample results for local development (no AWS needed)
DISCOVER_ENABLED=           # false switches the feature off
DISCOVER_DAILY_LIMIT=5      # fresh searches per user per day (cost guard); cached repeats are free
DISCOVER_CACHE_HOURS=24
BEDROCK_REGION=us-east-1    # Nova web grounding is only available in US regions
DISCOVER_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Locally, real AI search also needs AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (and AWS_SESSION_TOKEN) in the shell.
